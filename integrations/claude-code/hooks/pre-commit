#!/usr/bin/env bash
# Pre-commit hook: runs personal-agent review on staged changes.
# Copy to .git/hooks/pre-commit and chmod +x.
#
# This hook WARNS but does not block commits.
# Set PA_STRICT=1 to block commits on findings.

set -euo pipefail

if ! command -v pa &>/dev/null; then
    exit 0
fi

# Verify at least one API key is set
HAS_KEY=0
for var in COHERE_API_KEY GROQ_API_KEY OPENROUTER_API_KEY CEREBRAS_API_KEY GEMINI_API_KEY; do
    if [ -n "${!var:-}" ]; then
        HAS_KEY=1
        break
    fi
done

if [ "$HAS_KEY" -eq 0 ]; then
    echo "personal-agent: no API keys set, skipping review"
    exit 0
fi

DIFF=$(git diff --cached --diff-filter=ACMR)
if [ -z "$DIFF" ]; then
    exit 0
fi

echo "Running personal-agent review on staged changes..."

RESULT=$(pa --investigate "Review these staged changes for critical bugs and security issues. Be concise." --repo . --json 2>/dev/null || true)

if [ -z "$RESULT" ]; then
    exit 0
fi

FINDINGS=$(echo "$RESULT" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    for f in data.get('findings', []):
        print(f'  - {f}')
except Exception:
    pass
" 2>/dev/null || true)

if [ -n "$FINDINGS" ]; then
    echo ""
    echo "personal-agent findings:"
    echo "$FINDINGS"
    echo ""
    if [ "${PA_STRICT:-0}" = "1" ]; then
        echo "Commit blocked (PA_STRICT=1). Fix findings or unset PA_STRICT to proceed."
        exit 1
    fi
fi

exit 0
